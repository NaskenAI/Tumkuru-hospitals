# Copy to .env.local and fill in. Never commit .env.local.

# --- Supabase ---------------------------------------------------------------
# For local development, run `npx supabase start` (needs Docker) and paste the
# printed API URL + service_role key here.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Admin auth (REQUIRED) --------------------------------------------------
# Without both set, /admin and internal /api are locked.
#   ADMIN_SESSION_SECRET: generate with `openssl rand -hex 32`
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# --- LLM provider (Google Gemini) -------------------------------------------
# ONE key enables live extraction, English generation, and Kannada translation.
LLM_API_KEY=
LLM_MODEL=gemini-2.0-flash

# --- Cost caps --------------------------------------------------------------
AI_TOKEN_CAP_PER_LEAD=20000
AI_COST_CAP_PER_RUN_INR=250

# --- Screenshots ------------------------------------------------------------
# Base URL the screenshot browser loads previews from (usually the dev server).
APP_BASE_URL=http://localhost:3000
# Real capture also needs: npm i -D playwright && npx playwright install chromium

# --- Scoring (optional heuristic weight overrides) --------------------------
# e.g. {"auditWeights":{"mobile_viewport":20},"fit":{"phone":15}}
SCORING_CONFIG_JSON=
