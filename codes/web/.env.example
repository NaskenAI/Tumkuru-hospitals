# Copy to .env.local and fill in. Never commit .env.local.

# --- Supabase ---------------------------------------------------------------
# Server-side admin/pipeline operations use the service-role key.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Client-safe anon key (reserved for future public reads).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Admin auth (REQUIRED) --------------------------------------------------
# Without both of these set, /admin and internal /api endpoints are locked.
# ADMIN_PASSWORD: the shared password entered on /admin/login.
# ADMIN_SESSION_SECRET: a long random string used to sign session cookies.
#   Generate one with: openssl rand -hex 32
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# --- LLM provider (Google Gemini) -------------------------------------------
LLM_API_KEY=
# Default stable Flash model; pricing defined in src/lib/ai/pricing.ts.
LLM_MODEL=gemini-3.6-flash

# --- Cost caps --------------------------------------------------------------
AI_TOKEN_CAP_PER_LEAD=20000
AI_COST_CAP_PER_RUN_INR=250
# Approximate USD->INR rate for INR cost estimates (not exact).
USD_TO_INR=88

# --- Scoring (optional overrides; see lib/audit/scoring-config.ts) -----------
# Provide a JSON object to override audit-check weights, e.g.:
# SCORING_CONFIG_JSON={"auditWeights":{"mobile_viewport":20},"fitWeights":{"phone":15}}
SCORING_CONFIG_JSON=
